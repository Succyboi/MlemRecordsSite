				<description>&lt;p&gt;Mlem Records an artist collective run by &lt;span&gt;&#xD;&#xA;    &lt;script type=&#34;text/javascript&#34;&gt;&#xD;&#xA;        function reroll_creatures_highlight() {&#xD;&#xA;            var highlightContainer = document.getElementById(&#39;creatures-highlight&#39;);&#xD;&#xA;&#xD;&#xA;            if (highlightContainer == null) { return; }&#xD;&#xA;&#xD;&#xA;            var creatures = [&#xD;&#xA;                &#34;dogs&#34;,&#xD;&#xA;                &#34;cats&#34;,&#xD;&#xA;                &#34;aliens&#34;,&#xD;&#xA;                &#34;vegans&#34;,&#xD;&#xA;                &#34;ghouls&#34;,&#xD;&#xA;                &#34;birds&#34;,&#xD;&#xA;                &#34;jesters&#34;,&#xD;&#xA;                &#34;lawyers&#34;,&#xD;&#xA;                &#34;businesspeople&#34;,&#xD;&#xA;                &#34;moms&#34;,&#xD;&#xA;                &#34;scientists&#34;,&#xD;&#xA;                &#34;professors&#34;,&#xD;&#xA;                &#34;souls&#34;,&#xD;&#xA;                &#34;sisters&#34;,&#xD;&#xA;                &#34;royals&#34;,&#xD;&#xA;                &#34;fish&#34;,&#xD;&#xA;                &#34;dust-particles&#34;,&#xD;&#xA;                &#34;orbs&#34;,&#xD;&#xA;                &#34;computers&#34;,&#xD;&#xA;                &#34;students&#34;,&#xD;&#xA;                &#34;queers&#34;&#xD;&#xA;            ];&#xD;&#xA;            var prefixes = [&#xD;&#xA;                &#34;hungry&#34;,&#xD;&#xA;                &#34;rabid&#34;,&#xD;&#xA;                &#34;magical&#34;,&#xD;&#xA;                &#34;mushy&#34;,&#xD;&#xA;                &#34;vegan&#34;,&#xD;&#xA;                &#34;hyperactive&#34;,&#xD;&#xA;                &#34;blood-sucking&#34;,&#xD;&#xA;                &#34;old-fashioned&#34;,&#xD;&#xA;                &#34;irritating&#34;,&#xD;&#xA;                &#34;dazzling&#34;,&#xD;&#xA;                &#34;motionless&#34;,&#xD;&#xA;                &#34;lewd&#34;,&#xD;&#xA;                &#34;unwieldy&#34;,&#xD;&#xA;                &#34;crooked&#34;,&#xD;&#xA;                &#34;overconfident&#34;,&#xD;&#xA;                &#34;brawny&#34;,&#xD;&#xA;                &#34;grimey&#34;,&#xD;&#xA;                &#34;repulsive&#34;,&#xD;&#xA;                &#34;ruthless&#34;,&#xD;&#xA;                &#34;wild&#34;,&#xD;&#xA;                &#34;psychedelic&#34;,&#xD;&#xA;                &#34;bankrupted&#34;,&#xD;&#xA;                &#34;malicious&#34;,&#xD;&#xA;                &#34;acidic&#34;,&#xD;&#xA;                &#34;slimey&#34;,&#xD;&#xA;                &#34;mad&#34;,&#xD;&#xA;                &#34;floating&#34;,&#xD;&#xA;                &#34;shiny&#34;&#xD;&#xA;            ];&#xD;&#xA;&#xD;&#xA;            var highlight_person = creatures[Math.floor(Math.random() * creatures.length)];&#xD;&#xA;            var highlight_prefix = prefixes[Math.floor(Math.random() * prefixes.length)];&#xD;&#xA;            highlightContainer.innerHTML = `${highlight_prefix} ${highlight_person}`;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        document.addEventListener(&#39;DOMContentLoaded&#39;, function() { reroll_creatures_highlight(); });&#xD;&#xA;    &lt;/script&gt;&#xD;&#xA;&#xD;&#xA;    &lt;span id=&#34;creatures-highlight&#34; style=&#34;cursor:pointer; user-select: none;&#34; onclick=&#34;reroll_creatures_highlight()&#34;&gt;aliens&lt;/span&gt;&#xD;&#xA;&lt;/span&gt; in &lt;span&gt;&#xD;&#xA;    &lt;script type=&#34;text/javascript&#34;&gt;&#xD;&#xA;        function reroll_places_highlight() {&#xD;&#xA;            var highlightContainer = document.getElementById(&#39;places-highlight&#39;);&#xD;&#xA;&#xD;&#xA;            if (highlightContainer == null) { return; }&#xD;&#xA;&#xD;&#xA;            var places = [&#xD;&#xA;                &#34;cyberspace&#34;,&#xD;&#xA;                &#34;Utrecht&#34;,&#xD;&#xA;                &#34;heaven&#34;,&#xD;&#xA;                &#34;mid-life crisis&#34;,&#xD;&#xA;                &#34;distress&#34;,&#xD;&#xA;                &#34;pieces&#34;,&#xD;&#xA;                &#34;disarray&#34;,&#xD;&#xA;                &#34;bushes&#34;,&#xD;&#xA;                &#34;a hostage situation&#34;,&#xD;&#xA;                &#34;train stations&#34;,&#xD;&#xA;                &#34;secret labs&#34;,&#xD;&#xA;                &#34;pet stores&#34;,&#xD;&#xA;                &#34;prison&#34;,&#xD;&#xA;                &#34;kennels&#34;,&#xD;&#xA;                &#34;your walls&#34;,&#xD;&#xA;                &#34;government&#34;,&#xD;&#xA;                &#34;pools&#34;,&#xD;&#xA;                &#34;STEM&#34;&#xD;&#xA;            ];&#xD;&#xA;&#xD;&#xA;            var highlight_places = places[Math.floor(Math.random() * places.length)];&#xD;&#xA;            highlightContainer.innerHTML = `${highlight_places}`;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        document.addEventListener(&#39;DOMContentLoaded&#39;, function() { reroll_places_highlight(); });&#xD;&#xA;    &lt;/script&gt;&#xD;&#xA;&#xD;&#xA;    &lt;span id=&#34;places-highlight&#34; style=&#34;cursor:pointer; user-select: none;&#34; onclick=&#34;reroll_places_highlight()&#34;&gt;cyberspace&lt;/span&gt;&lt;/span&gt;.&lt;/p&gt;</description>
