34;ruthless&#34;,&#xA;                &#34;wild&#34;,&#xA;                &#34;psychedelic&#34;,&#xA;                &#34;bankrupted&#34;,&#xA;                &#34;malicious&#34;,&#xA;                &#34;acidic&#34;,&#xA;                &#34;slimey&#34;,&#xA;                &#34;mad&#34;,&#xA;                &#34;floating&#34;,&#xA;                &#34;shiny&#34;&#xA;            ];&#xA;&#xA;            var highlight_person = creatures[Math.floor(Math.random() * creatures.length)];&#xA;            var highlight_prefix = prefixes[Math.floor(Math.random() * prefixes.length)];&#xA;            highlightContainer.innerHTML = `${highlight_prefix} ${highlight_person}`;&#xA;        }&#xA;&#xA;        document.addEventListener(&#39;DOMContentLoaded&#39;, function() { reroll_creatures_highlight(); });&#xA;    &lt;/script&gt;&#xA;&#xA;    &lt;span id=&#34;creatures-highlight&#34; style=&#34;cursor:pointer; user-select: none;&#34; onclick=&#34;reroll_creatures_highlight()&#34;&gt;aliens&lt;/span&gt;&#xA;&lt;/span&gt; in &lt;span&gt;&#xA;    &lt;script type=&#34;text/javascript&#34;&gt;&#xA;        function reroll_places_highlight() {&#xA;            var highlightContainer = document.getElementById(&#39;places-highlight&#39;);&#xA;&#xA;            if (highlightContainer == null) { return; }&#xA;&#xA;            var places = [&#xA;                &#34;cyberspace&#34;,&#xA;                &#34;Utrecht&#34;,&#xA;                &#34;heaven&#34;,&#xA;                &#34;mid-life crisis&#34;,&#xA;                &#34;distress&#34;,&#xA;                &#34;pieces&#34;,&#xA;                &#34;disarray&#34;,&#xA;                &#34;bushes&#34;,&#xA;                &#34;a hostage situation&#34;,&#xA;                &#34;train stations&#34;,&#xA;                &#34;secret labs&#34;,&#xA;                &#34;pet stores&#34;,&#xA;                &#34;prison&#34;,&#xA;                &#34;kennels&#34;,&#xA;                &#34;your walls&#34;,&#xA;                &#34;government&#34;,&#xA;                &#34;pools&#34;,&#xA;                &#34;STEM&#34;&#xA;            ];&#xA;&#xA;            var highlight_places = places[Math.floor(Math.random() * places.length)];&#xA;            highlightContainer.innerHTML = `${highlight_places}`;&#xA;        }&#xA;&#xA;        document.addEventListener(&#39;DOMContentLoaded&#39;, function() { reroll_places_highlight(); });&#xA;    &lt;/script&gt;&#xA;&#xA;    &lt;span id=&#34;places-highlight&#34; style=&#34;cursor:pointer; user-select: none;&#34; onclick=&#34;reroll_places_highlight()&#34;&gt;cyberspace&lt;/span&gt;&lt;/span&gt;.&lt;/p&gt;</description>
